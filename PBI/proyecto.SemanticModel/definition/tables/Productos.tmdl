	partition Productos = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "Productos.csv"),[Delimiter=",", Columns=5, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    #"Encabezados promovidos" = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(#"Encabezados promovidos",{{"ProductoID", type text}, {"Producto", type text}, {"Categoria", type text}, {"Costo", Int64.Type}, {"Precio", Int64.Type}}, "en-US")
				in
				    #"Tipo cambiado"

	annotation PBI_ResultType = Table

