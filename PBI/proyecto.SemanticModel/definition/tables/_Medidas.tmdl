table _Medidas
	lineageTag: 868374c1-87bd-4c5e-8557-ab7f3930b5d7

	measure 'Ventas Brutas' = SUMX(Ventas, Ventas[Cantidad] * Ventas[PrecioUnitario])
		formatString: \$#,0
		lineageTag: 43a14025-0f69-41f2-8ed5-58a57a87d8b7

	measure Descuentos = SUMX(Ventas, Ventas[Cantidad] * Ventas[PrecioUnitario] * Ventas[Descuento])
		formatString: \$#,0
		lineageTag: 6937d56b-08ab-4bda-8f32-7a96048aaed0

	measure 'Ventas Netas' = [Ventas Brutas] - [Descuentos]
		formatString: \$#,0
		lineageTag: 65f6abc5-f31d-452f-b303-6666180f8923

	measure 'Costo Total' = SUMX(Ventas, Ventas[Cantidad] * RELATED(Productos[Costo]))
		formatString: \$#,0
		lineageTag: e2ce4a1d-8d79-484e-8d7a-6849765ce38d

	measure 'Ganancia Bruta' = [Ventas Netas] - [Costo Total]
		formatString: \$#,0
		lineageTag: fa0b55bc-d823-49b2-959f-630866a1fb5c

	measure 'Margen %' = DIVIDE([Ganancia Bruta], [Ventas Netas])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 47a1c202-c95f-46d3-a5a4-5fd8ca293a86

	measure 'Unidades Vendidas' = SUM(Ventas[Cantidad])
		formatString: #,0
		lineageTag: 7ddae82e-4f64-4ea5-b2ef-6fd6a98df24e

	measure 'Numero Transacciones' = DISTINCTCOUNT(Ventas[VentaID])
		formatString: #,0
		lineageTag: 997383a1-b575-4a91-81dc-539314df3f6e

	measure 'Ticket Promedio' = DIVIDE([Ventas Netas], [Numero Transacciones])
		formatString: \$#,0.00
		lineageTag: 8fe1dda5-ac75-4f43-bff1-0b74139f1d34

	measure 'Ventas Netas Mes Anterior' = CALCULATE([Ventas Netas], DATEADD('Calendario'[Date], -1, MONTH))
		formatString: \$#,0
		lineageTag: 6cf3e1fd-0785-4fb0-8b30-1cab39190c98

	measure 'Ventas Netas Var %' = DIVIDE([Ventas Netas] - [Ventas Netas Mes Anterior], [Ventas Netas Mes Anterior])
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 892f6585-084b-4249-b630-5775a482edcb

	measure 'Ganancia Bruta Mes Anterior' = CALCULATE([Ganancia Bruta], DATEADD('Calendario'[Date], -1, MONTH))
		formatString: \$#,0
		lineageTag: 4850c45b-9000-409d-9f9a-4ea32206bd01

	measure 'Ganancia Bruta Var %' = DIVIDE([Ganancia Bruta] - [Ganancia Bruta Mes Anterior], [Ganancia Bruta Mes Anterior])
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 6ce8db46-949e-4a1e-b7ff-76158307aa7b

	measure 'Margen % Mes Anterior' = CALCULATE([Margen %], DATEADD('Calendario'[Date], -1, MONTH))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 18639ba6-089c-4ea6-a45d-c4e024bcdd47

	measure 'Margen Var pp' = [Margen %] - [Margen % Mes Anterior]
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 44586389-0ca3-4915-b75c-adfbd614dba1

	measure 'Ticket Promedio Mes Anterior' = CALCULATE([Ticket Promedio], DATEADD('Calendario'[Date], -1, MONTH))
		formatString: \$#,0.00
		lineageTag: a39583aa-2996-4351-b282-419bbd4fd2d5

	measure 'Ticket Promedio Var %' = DIVIDE([Ticket Promedio] - [Ticket Promedio Mes Anterior], [Ticket Promedio Mes Anterior])
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 47f5a747-d5b2-424c-99cf-2c9a7328c97a

	measure 'Descuentos Mes Anterior' = CALCULATE([Descuentos], DATEADD('Calendario'[Date], -1, MONTH))
		formatString: \$#,0
		lineageTag: 80529c02-2311-4b3a-b847-23c75c97b639

	measure 'Descuentos Var %' = DIVIDE([Descuentos] - [Descuentos Mes Anterior], [Descuentos Mes Anterior])
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 9bf440b8-6ef5-44a6-8a42-1bdbc0b15ef8

	measure 'Ranking Producto' = RANKX(ALL(Productos[Producto]), [Ventas Netas], , DESC, Dense)
		formatString: 0
		lineageTag: 226e880d-dd62-476f-9cae-b87799bf513d

	measure 'Ventas Acumuladas' =
			VAR RankActual = [Ranking Producto]
			RETURN
			    CALCULATE(
			        [Ventas Netas],
			        FILTER(ALL(Productos[Producto]), [Ranking Producto] <= RankActual)
			    )
		formatString: \$#,0
		lineageTag: ff8d8453-4ded-499e-b1a2-4fe005ba6eeb

	measure '% Acumulado' = DIVIDE([Ventas Acumuladas], CALCULATE([Ventas Netas], ALL(Productos)))
		formatString: 0%
		lineageTag: 1c870c69-e839-4b26-a77b-eb2f0ac3860f

	measure '% Metodo Pago' = DIVIDE([Ventas Netas], CALCULATE([Ventas Netas], ALL(Ventas[MetodoPago])))
		formatString: 0%
		lineageTag: aaaf656d-918a-4c6c-a184-b7bacc4ff135

	measure '% Canal' = DIVIDE([Ventas Netas], CALCULATE([Ventas Netas], ALL(Ventas[CanalVenta])))
		formatString: 0%
		lineageTag: 3a0a03c0-f394-4621-a712-d126be25b765

	measure 'Ventas por Día' = DIVIDE ( [Ventas Netas], DISTINCTCOUNT ( Ventas[Fecha] ) )
		lineageTag: 9ae1ccea-a9d2-41ca-8471-f29ad9740499

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Tabla de medidas'
		lineageTag: 92663e3c-28ad-4b63-a03d-162b51c8da3b
		isNameInferred
		sourceColumn: [Tabla de medidas]

	partition _Medidas = calculated
		mode: import
		source = ROW("Tabla de medidas", "KPIs de Cafetería ABC")

