{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.141.json",
  "name": "Cafeteria ABC - Corporate Modern",
  "dataColors": [
    "#4D2C19",
    "#E1C1A2",
    "#F0BBA0",
    "#C9C6C3",
    "#83746D",
    "#725A41",
    "#9F9C9A",
    "#D5C3BB"
  ],
  "good": "#2E7D46",
  "neutral": "#83746D",
  "bad": "#BA1A1A",
  "maximum": "#4D2C19",
  "center": "#E1C1A2",
  "minimum": "#F5ECE7",
  "null": "#D5C3BB",
  "foreground": "#1E1B18",
  "foregroundNeutralSecondary": "#51443E",
  "foregroundNeutralTertiary": "#83746D",
  "background": "#FFFFFF",
  "backgroundLight": "#F5F1EE",
  "backgroundNeutral": "#E9E1DC",
  "tableAccent": "#4D2C19",
  "textClasses": {
    "label": {
      "fontFace": "Inter, Segoe UI, wf_standard-font, helvetica, arial, sans-serif",
      "fontSize": 10.5,
      "color": "#51443E"
    },
    "callout": {
      "fontFace": "Inter, Segoe UI, wf_standard-font, helvetica, arial, sans-serif",
      "fontSize": 21,
      "color": "#4D2C19"
    },
    "title": {
      "fontFace": "Inter, Segoe UI, wf_standard-font, helvetica, arial, sans-serif",
      "fontSize": 12,
      "color": "#1E1B18"
    },
    "header": {
      "fontFace": "Inter, Segoe UI, wf_standard-font, helvetica, arial, sans-serif",
      "fontSize": 18,
      "color": "#1E1B18"
    },
    "largeTitle": {
      "fontFace": "Inter, Segoe UI, wf_standard-font, helvetica, arial, sans-serif",
      "fontSize": 24,
      "color": "#341706"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "transparency": 0,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "border": [
          {
            "show": true,
            "radius": 16,
            "color": {
              "solid": {
                "color": "#E5E1DE"
              }
            }
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "position": "Outer",
            "preset": "Custom",
            "color": {
              "solid": {
                "color": "#4D2C19"
              }
            },
            "transparency": 95,
            "shadowBlur": 4,
            "shadowDistance": 2,
            "shadowSpread": 0,
            "angle": 90
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#1E1B18"
              }
            },
            "fontSize": 15,
            "fontFamily": "Inter, Segoe UI, wf_standard-font, helvetica, arial, sans-serif",
            "bold": true,
            "alignment": "left",
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "subTitle": [
          {
            "fontColor": {
              "solid": {
                "color": "#83746D"
              }
            },
            "fontSize": 9,
            "fontFamily": "Inter, Segoe UI, wf_standard-font, helvetica, arial, sans-serif"
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontSize": 9,
            "fontFamily": "Inter, Segoe UI, wf_standard-font, helvetica, arial, sans-serif",
            "labelColor": {
              "solid": {
                "color": "#51443E"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "fontSize": 9,
            "fontFamily": "Inter, Segoe UI, wf_standard-font, helvetica, arial, sans-serif",
            "color": {
              "solid": {
                "color": "#51443E"
              }
            },
            "gridline": {
              "show": false,
              "color": {
                "solid": {
                  "color": "#F0EEEC"
                }
              }
            }
          }
        ],
        "valueAxis": [
          {
            "fontSize": 9,
            "fontFamily": "Inter, Segoe UI, wf_standard-font, helvetica, arial, sans-serif",
            "color": {
              "solid": {
                "color": "#51443E"
              }
            },
            "gridline": {
              "show": true,
              "color": {
                "solid": {
                  "color": "#F0EEEC"
                }
              }
            }
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#1E1B18"
              }
            },
            "fontSize": 9,
            "fontFamily": "Inter, Segoe UI, wf_standard-font, helvetica, arial, sans-serif"
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#4D2C19"
              }
            },
            "fontSize": 21,
            "bold": true,
            "fontFamily": "Inter, Segoe UI, wf_standard-font, helvetica, arial, sans-serif"
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#51443E"
              }
            },
            "fontSize": 9,
            "bold": true,
            "fontFamily": "Inter, Segoe UI, wf_standard-font, helvetica, arial, sans-serif"
          }
        ]
      }
    },
    "multiRowCard": {
      "*": {
        "dataLabels": [
          {
            "color": {
              "solid": {
                "color": "#4D2C19"
              }
            },
            "fontSize": 21,
            "bold": true,
            "fontFamily": "Inter, Segoe UI, wf_standard-font, helvetica, arial, sans-serif"
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#51443E"
              }
            },
            "fontSize": 9,
            "bold": true,
            "fontFamily": "Inter, Segoe UI, wf_standard-font, helvetica, arial, sans-serif"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFF8F5"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#1E1B18"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 9,
            "bold": true,
            "fontFamily": "Inter, Segoe UI, wf_standard-font, helvetica, arial, sans-serif"
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#2D2926"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 9,
            "fontFamily": "Inter, Segoe UI, wf_standard-font, helvetica, arial, sans-serif"
          }
        ],
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#F0EEEC"
              }
            },
            "rowPadding": 8
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "radius": 9999,
            "color": {
              "solid": {
                "color": "#D5C3BB"
              }
            }
          }
        ]
      }
    }
  }
}